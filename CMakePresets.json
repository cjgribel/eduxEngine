{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 19,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug-all",
            "displayName": "Debug: all",
            "configurePreset": "debug",
            "configuration": "Debug"
        },
        {
            "name": "debug-legacy-game",
            "displayName": "Debug: LegacyGame",
            "configurePreset": "debug",
            "configuration": "Debug",
            "targets": [
                "LegacyGame"
            ]
        },
        {
            "name": "debug-reference-game",
            "displayName": "Debug: ReferenceGame",
            "configurePreset": "debug",
            "configuration": "Debug",
            "targets": [
                "ReferenceGame"
            ]
        },
        {
            "name": "debug-fluid-sandbox",
            "displayName": "Debug: FluidSandbox",
            "configurePreset": "debug",
            "configuration": "Debug",
            "targets": [
                "FluidSandbox"
            ]
        },
        {
            "name": "debug-blazter",
            "displayName": "Debug: Blazter",
            "configurePreset": "debug",
            "configuration": "Debug",
            "targets": [
                "Blazter"
            ]
        },
        {
            "name": "debug-tests",
            "displayName": "Debug: tests",
            "configurePreset": "debug",
            "configuration": "Debug",
            "targets": [
                "tests"
            ]
        },
        {
            "name": "release-all",
            "displayName": "Release: all",
            "configurePreset": "release",
            "configuration": "Release"
        },
        {
            "name": "release-legacy-game",
            "displayName": "Release: LegacyGame",
            "configurePreset": "release",
            "configuration": "Release",
            "targets": [
                "LegacyGame"
            ]
        },
        {
            "name": "release-reference-game",
            "displayName": "Release: ReferenceGame",
            "configurePreset": "release",
            "configuration": "Release",
            "targets": [
                "ReferenceGame"
            ]
        },
        {
            "name": "release-fluid-sandbox",
            "displayName": "Release: FluidSandbox",
            "configurePreset": "release",
            "configuration": "Release",
            "targets": [
                "FluidSandbox"
            ]
        },
        {
            "name": "release-blazter",
            "displayName": "Release: Blazter",
            "configurePreset": "release",
            "configuration": "Release",
            "targets": [
                "Blazter"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "displayName": "Debug: tests",
            "configurePreset": "debug",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "release",
            "displayName": "Release: tests",
            "configurePreset": "release",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
